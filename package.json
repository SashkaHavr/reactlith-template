{
  "name": "reactlith-template",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "git clean -xdfq 'node_modules/*' '**/node_modules/*' '**/dist/*'",
    "postinstall": "vpr @reactlith-template/intl#build",
    "build": "vpr -r build",
    "compose": "docker compose -f docker-compose.yaml -f docker-compose.localhost.yaml up --build -d",
    "dev": "vpr -r --parallel dev"
  },
  "devDependencies": {
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@11.10.0"
}
