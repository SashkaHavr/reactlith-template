{
  "name": "reactlith-template",
  "private": true,
  "workspaces": {
    "packages": [
      ".railway",
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@tanstack/react-form": "1.33.5",
      "@types/bun": "1.4.2",
      "better-auth": "1.7.4",
      "better-result": "3.0.1",
      "lucide-react": "1.45.0",
      "evlog": "2.29.0",
      "drizzle-kit": "1.0.0-rc.5-ab785fc",
      "drizzle-orm": "1.0.0-rc.5-ab785fc",
      "drizzle-seed": "1.0.0-rc.5-ab785fc",
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0",
      "react": "19.3.0",
      "react-dom": "19.3.0",
      "@tailwindcss/vite": "4.3.3",
      "class-variance-authority": "0.7.1",
      "tailwindcss": "4.3.3",
      "tw-animate-css": "1.4.0",
      "@tanstack/react-query": "5.102.8",
      "@tanstack/react-router": "1.170.35",
      "@tanstack/react-router-ssr-query": "1.167.2",
      "@tanstack/react-start": "1.168.52",
      "vite": "8.3.0",
      "@vitejs/plugin-react": "6.1.1",
      "oxc-transform-react": "0.149.0",
      "nitro": "3.0.260903-beta",
      "@inlang/paraglide-js": "2.25.1",
      "pg": "8.23.0",
      "effect": "4.0.0-rc.115",
      "@effect/sql-pg": "4.0.0-rc.115",
      "@effect/sql-pglite": "4.0.0-rc.115",
      "@effect/platform-node": "4.0.0-rc.115",
      "cn": "0.2.6",
      "@types/node": "^26.5.1"
    }
  },
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "clean": "git clean -xdfq 'node_modules/*' '**/node_modules/*' '**/dist/*'",
    "format": "bun --bun oxfmt",
    "format:check": "bun --bun oxfmt --check",
    "lint": "bun --bun oxlint",
    "lint:fix": "bun --bun oxlint --fix",
    "check": "bun --bun oxlint && bun --bun oxfmt --check",
    "fix": "bun --bun oxlint --fix && bun --bun oxfmt",
    "test": "bun --bun vitest run",
    "compose": "docker compose -f docker-compose.yaml -f docker-compose.localhost.yaml up --build -d",
    "deps": "bun update --interactive --recursive",
    "dev": "turbo dev --env-mode=loose",
    "postinstall": "effect-tsgo patch --oxlint",
    "prepare": "if [ -f packages/intl/index.html ] && [ -d packages/intl/node_modules ]; then bun run --filter @reactlith-template/intl build; fi"
  },
  "devDependencies": {
    "@effect/tsgo": "0.45.0",
    "@effect/vitest": "4.0.0-rc.115",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "turbo": "2.10.12",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  },
  "packageManager": "bun@1.4.2"
}
