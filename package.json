{
  "name": "reactlith-template",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@t3-oss/env-core": "0.13.11",
      "@tanstack/react-form": "1.33.2",
      "@types/bun": "1.3.14",
      "better-auth": "1.6.24",
      "better-result": "2.10.0",
      "lucide-react": "1.25.0",
      "superjson": "2.2.6",
      "typescript": "7.0.2",
      "uuid": "14.0.1",
      "zod": "4.4.3",
      "evlog": "2.22.3",
      "drizzle-kit": "1.0.0-rc.4",
      "drizzle-orm": "1.0.0-rc.4",
      "drizzle-seed": "1.0.0-rc.4",
      "@types/react": "19.2.17",
      "@types/react-dom": "19.2.3",
      "react": "19.2.8",
      "react-dom": "19.2.8",
      "babel-plugin-react-compiler": "1.0.0",
      "@tailwindcss/vite": "4.3.3",
      "class-variance-authority": "0.7.1",
      "clsx": "2.1.1",
      "tailwind-merge": "3.6.0",
      "tailwindcss": "4.3.3",
      "tw-animate-css": "1.4.0",
      "@tanstack/react-query": "5.101.4",
      "@trpc/client": "11.18.0",
      "@trpc/server": "11.18.0",
      "@trpc/tanstack-react-query": "11.18.0",
      "@tanstack/react-router": "1.170.18",
      "@tanstack/react-router-ssr-query": "1.167.1",
      "@tanstack/react-start": "1.168.32",
      "@tanstack/router-plugin": "1.168.23",
      "@vitejs/plugin-react": "6.0.4",
      "@types/babel__core": "7.20.5",
      "vite": "8.1.5",
      "@rolldown/plugin-babel": "0.2.3",
      "nitro": "3.0.260610-beta",
      "@inlang/paraglide-js": "2.22.0",
      "unctx": "3.0.0"
    }
  },
  "type": "module",
  "scripts": {
    "build": "bun run --filter '*' build",
    "clean": "git clean -xdfq 'node_modules/*' '**/node_modules/*' '**/dist/*'",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "bunx --no-install oxlint",
    "lint:fix": "bunx --no-install oxlint --fix",
    "check": " bunx --no-install oxlint && bunx --no-install oxfmt --check",
    "fix": "bunx --no-install oxlint --fix && bunx --no-install oxfmt",
    "compose": "docker compose -f docker-compose.yaml -f docker-compose.localhost.yaml up --build -d",
    "deps": "bun update --interactive --recursive",
    "dev": "bun run --filter '*' dev"
  },
  "devDependencies": {
    "oxfmt": "0.60.0",
    "oxlint": "1.75.0",
    "oxlint-tsgolint": "7.0.2001"
  },
  "packageManager": "bun@1.3.14"
}
