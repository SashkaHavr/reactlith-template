{
  "name": "reactlith-template",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vpr -r build",
    "clean": "git clean -xdfq 'node_modules/*' '**/node_modules/*' '**/dist/*'",
    "compose": "docker compose -f docker-compose.yaml -f docker-compose.localhost.yaml up --build -d",
    "deps": "vp update -i -r --latest",
    "dev": "turbo dev --env-mode=loose",
    "postinstall": "effect-tsgo patch --oxlint",
    "prepare": "vp hooks enable && if [ -f packages/intl/index.html ] && [ -d packages/intl/node_modules ]; then vpr intl#build; fi"
  },
  "devDependencies": {
    "@effect/tsgo": "0.63.0",
    "@effect/vitest": "4.1.1",
    "turbo": "2.11.10",
    "typescript": "7.0.2",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.17.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "26.13.0"
  }
}
