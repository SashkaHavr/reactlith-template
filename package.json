{
  "name": "reactlith-template",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@t3-oss/env-core": "0.13.11",
      "@tanstack/react-form": "1.32.0",
      "@types/bun": "1.3.12",
      "better-auth": "1.6.11",
      "better-result": "2.9.2",
      "lucide-react": "1.16.0",
      "superjson": "2.2.6",
      "typescript": "6.0.3",
      "use-intl": "4.12.0",
      "uuid": "14.0.0",
      "zod": "4.4.3",
      "evlog": "2.17.0",
      "effect": "4.0.0-beta.78"
    },
    "catalogs": {
      "drizzle": {
        "drizzle-kit": "1.0.0-rc.2",
        "drizzle-orm": "1.0.0-rc.2",
        "drizzle-seed": "1.0.0-rc.2"
      },
      "react": {
        "@types/react": "19.2.14",
        "@types/react-dom": "19.2.3",
        "react": "19.2.6",
        "react-dom": "19.2.6",
        "babel-plugin-react-compiler": "1.0.0"
      },
      "tailwind": {
        "@tailwindcss/vite": "4.3.0",
        "class-variance-authority": "0.7.1",
        "clsx": "2.1.1",
        "tailwind-merge": "3.6.0",
        "tailwindcss": "4.3.0",
        "tw-animate-css": "1.4.0"
      },
      "trpc": {
        "@tanstack/react-query": "5.100.10",
        "@trpc/client": "11.17.0",
        "@trpc/server": "11.17.0",
        "@trpc/tanstack-react-query": "11.17.0"
      },
      "vite": {
        "@tanstack/react-router": "1.170.4",
        "@tanstack/react-router-ssr-query": "1.167.0",
        "@tanstack/react-start": "1.168.6",
        "@tanstack/router-plugin": "1.168.6",
        "@vitejs/plugin-react": "6.0.2",
        "@types/babel__core": "7.20.5",
        "vite": "8.0.13",
        "@rolldown/plugin-babel": "0.2.3",
        "nitro": "3.0.260429-beta"
      }
    }
  },
  "type": "module",
  "scripts": {
    "build": "bun run --filter '*' build",
    "clean": "git clean -xdfq 'node_modules/*' '**/node_modules/*' '**/dist/*'",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "bunx --no-install --bun oxlint",
    "lint:fix": "bunx --no-install --bun oxlint --fix",
    "check": " bunx --no-install --bun oxlint && bunx --no-install oxfmt --check",
    "fix": "bunx --no-install --bun oxlint --fix && bunx --no-install oxfmt",
    "compose": "docker compose -f docker-compose.yaml -f docker-compose.dev.yaml up --build -d",
    "deps": "bun update --interactive --recursive"
  },
  "devDependencies": {
    "oxfmt": "0.50.0",
    "oxlint": "1.65.0",
    "oxlint-tsgolint": "0.22.1"
  },
  "packageManager": "bun@1.3.11"
}
