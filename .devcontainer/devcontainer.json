{
  "name": "Dev Container",
  "dockerComposeFile": "docker-compose.yaml",
  "service": "devcontainer",
  "workspaceFolder": "/home/vscode/reactlith-template",
  "postCreateCommand": "nohup opencode serve --hostname 0.0.0.0 --port 4096 > ~/opencode.log 2>&1 & bun install",
  "remoteUser": "vscode",
  "otherPortsAttributes": {
    "onAutoForward": "ignore"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "/extensions/proxy-links/proxy-links.vsix",
        "ms-azuretools.vscode-containers",
        "bradlc.vscode-tailwindcss",
        "oxc.oxc-vscode"
      ]
    }
  }
}
