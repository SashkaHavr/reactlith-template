{
  "name": "Dev Container",
  "dockerComposeFile": "docker-compose.yaml",
  "service": "devcontainer",
  "workspaceFolder": "/home/vscode/reactlith-template",
  "postCreateCommand": "bun install",
  "postStartCommand": {
    "opencode": "nohup bash -c 'opencode serve --hostname 0.0.0.0 --port 4096 > ~/opencode.log 2>&1 &' >/dev/null",
    "effect-clone": "if [ -d ./references/effect/.git ]; then git -C ./references/effect pull; else mkdir -p ./references && git clone https://github.com/Effect-TS/effect.git ./references/effect; fi"
  },
  "remoteUser": "vscode",
  "otherPortsAttributes": {
    "onAutoForward": "ignore"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "/extensions/proxy-links/proxy-links.vsix",
        "ms-azuretools.vscode-containers",
        "bradlc.vscode-tailwindcss",
        "oxc.oxc-vscode",
        "inlang.vs-code-extension"
      ]
    }
  }
}
