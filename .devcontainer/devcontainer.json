{
  "name": "Dev Container",
  "dockerComposeFile": "docker-compose.yaml",
  "service": "devcontainer",
  "workspaceFolder": "/home/vscode/reactlith-template",
  "postCreateCommand": "bun install",
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-azuretools.vscode-containers",
        "bradlc.vscode-tailwindcss",
        "oxc.oxc-vscode"
      ]
    }
  }
}
