{
  "name": "@reactlith-template/db",
  "private": true,
  "type": "module",
  "imports": {
    "#*": "./src/*.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./id-branded": "./src/utils/id-branded.ts",
    "./test-db": "./src/test-db.ts"
  },
  "scripts": {
    "dev": "bun run studio",
    "push": "bunx --no-install --bun drizzle-kit push",
    "studio": "bun run ../../.devcontainer/localhost.js && bunx --no-install --bun drizzle-kit studio --host 0.0.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.4",
    "@electric-sql/pglite-prepopulatedfs": "0.5.4",
    "@reactlith-template/env": "workspace:*",
    "@reactlith-template/typescript-config": "workspace:*",
    "@types/bun": "catalog:",
    "drizzle-kit": "catalog:",
    "drizzle-orm": "catalog:",
    "drizzle-seed": "catalog:",
    "pg": "catalog:",
    "typescript": "catalog:",
    "uuid": "catalog:",
    "zod": "catalog:"
  }
}
